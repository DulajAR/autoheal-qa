
{
  "name": "autoheal-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise AI-Powered Self-Healing Test Automation Framework built with Playwright, TypeScript, and Hybrid AI.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:list": "playwright test --list",
    "test:retry": "playwright test --retries=2",
    "test:trace": "playwright test --trace on",
    "test:reliability": "playwright test --config=playwright.reliability.config.ts",
    "test:reliability:list": "playwright test --config=playwright.reliability.config.ts --list",
    "report": "playwright show-report reports/html",
    "report:reliability": "playwright show-report reports/reliability-tests",
    "typecheck": "tsc --noEmit",
    "test:reporting": "node --test tests/reporting/*.test.cjs",
    "validate": "npm run typecheck && npm run test:list",
    "validate:report": "node scripts/validate-healing-report.cjs",
    "validate:report:baseline": "node scripts/validate-healing-report.cjs --baseline",
    "validate:reliability": "npm run typecheck && npm run test:reliability",
    "test:ai:smoke": "playwright test --config=playwright.ai-smoke.config.ts --grep-invert AI-SMOKE-003",
    "test:ai:live": "playwright test --config=playwright.ai-smoke.config.ts --grep AI-SMOKE-003",
    "clean": "node -e \"const fs=require('node:fs'); for(const p of ['test-results','reports','playwright-report']) fs.rmSync(p,{recursive:true,force:true})\""
  },
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "self-healing",
    "ai-testing",
    "quality-assurance",
    "e2e-testing",
    "hybrid-ai",
    "automation-framework"
  ],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2"
  }
}
